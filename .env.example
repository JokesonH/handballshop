# Stripe — dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Created when you register the webhook endpoint (see docs/commerce.md)
STRIPE_WEBHOOK_SECRET=whsec_...
# Only flip to true once the business is registered for GST/HST and Stripe
# Tax is configured. Leaving it false charges no tax at all — which is wrong,
# but visibly wrong, rather than quietly under-collecting.
STRIPE_TAX_ENABLED=false

# Gelato — dashboard.gelato.com, separate keys for test and live.
# Rotate immediately if this value is ever pasted into a chat, ticket, or
# anywhere else outside an env var store — Gelato has no way to tell a
# leaked key apart from a real request.
GELATO_API_KEY=

# Long random secret embedded in the inbound webhook URL itself:
#   /api/webhooks/gelato/<this value>
# Gelato's webhooks have no signature (unlike Stripe's), so this token is
# the only thing standing between that endpoint and a forged order-status
# update. Generate one with:
#   node -e "console.log(require('crypto').randomUUID()+require('crypto').randomUUID().replace(/-/g,''))"
GELATO_WEBHOOK_TOKEN=

# GitHub OAuth for the CMS at /admin
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
